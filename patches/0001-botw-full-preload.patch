diff --git a/src/Cafe/HW/Latte/Renderer/D3D12/D3D12PreloadPolicy.h b/src/Cafe/HW/Latte/Renderer/D3D12/D3D12PreloadPolicy.h
new file mode 100644
index 0000000..43d1f5b
--- /dev/null
+++ b/src/Cafe/HW/Latte/Renderer/D3D12/D3D12PreloadPolicy.h
@@ -0,0 +1,15 @@
+#pragma once
+
+// Uses Cemu's uint64 alias from the shared precompiled header.
+struct D3D12PreloadPolicy
+{
+	bool enabled;
+	bool startupOnly;
+	bool includeStale;
+
+	static constexpr D3D12PreloadPolicy Resolve(uint64 titleId, bool precompile, bool background, bool botwFullPreload)
+	{
+		const bool fullPreload = botwFullPreload && titleId == 0x00050000101c9400ULL;
+		return { precompile || fullPreload, background && !fullPreload, fullPreload };
+	}
+};
